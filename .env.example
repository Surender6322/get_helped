# Firebase Web Config
# Create a project at https://console.firebase.google.com → Project Settings → Web App
# Then copy the config values here. Restart `npm run dev` after editing.
#
# Leave VITE_USE_DEMO=true to run the app fully offline using an in-browser
# mock backend (no Firebase project required). Flip to false when you wire
# real Firebase credentials below.

VITE_USE_DEMO=true

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_URL=

# Optional: App Check (reCAPTCHA Enterprise) site key. When set, every
# Firebase call from the browser carries an App Check token, and the
# Firebase backend can be configured to reject calls without one.
# Set up at: Firebase Console → App Check → Web app → reCAPTCHA Enterprise.
# This is the *site* key (safe to expose). The *secret* key never leaves
# Google Cloud.
VITE_APP_CHECK_SITE_KEY=

# === Removed: VITE_GEMINI_API_KEY ===
# The AI Companion's Gemini API key NO LONGER lives client-side.
# It is now stored as a Cloud Functions secret. To configure it:
#
#   firebase functions:secrets:set GEMINI_API_KEY
#
# The browser bundle never sees the key — every Companion message is
# proxied through the `companionChat` Cloud Function.
