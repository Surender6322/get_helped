# Firebase Web Config
# Create a project at https://console.firebase.google.com → Project Settings → Web App.
# Then copy the config values here. Restart `npm run dev` after editing.
#
# Leave VITE_USE_DEMO=true to run the app fully offline using an in-browser
# mock backend (no Firebase project required). Flip to false when you wire
# real Firebase credentials below.

VITE_USE_DEMO=true

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_URL=

# Optional: App Check (reCAPTCHA Enterprise) site key. When set, every
# Firebase call from the browser carries an App Check token, and the
# Firebase backend can be configured to reject calls without one.
# This is the *site* key (safe to expose). The *secret* key never leaves
# Google Cloud. See: Firebase Console → App Check → Web app.
VITE_APP_CHECK_SITE_KEY=

# AI Companion proxy URL (Cloudflare Worker).
# The Companion's Gemini key NEVER lives in the browser. The browser
# calls this URL with a Firebase ID token; the Worker verifies the
# token, rate-limits per uid, and forwards to Gemini server-side.
# See worker/README.md for the 10-minute deploy guide.
#
# Example: https://gethelped-ai-proxy.your-name.workers.dev
VITE_AI_PROXY_URL=
