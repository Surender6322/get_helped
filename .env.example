# Firebase Web Config
# Create a project at https://console.firebase.google.com → Project Settings → Web App
# Then copy the config values here. Restart `npm run dev` after editing.
#
# Leave VITE_USE_DEMO=true to run the app fully offline using an in-browser
# mock backend (no Firebase project required). Flip to false when you wire
# real Firebase credentials below.

VITE_USE_DEMO=true

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_URL=

# Optional: Gemini API key powers the in-app AI Companion. Without this,
# the AI Companion page shows setup instructions instead.
# Get a free key at https://aistudio.google.com/apikey
# IMPORTANT: After deploying to a domain, restrict the key to that domain
# in Google Cloud Console → APIs & Services → Credentials.
VITE_GEMINI_API_KEY=
