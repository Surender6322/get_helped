rules_version = '2';

// Firestore security rules for GetHelped — Spark-compatible Phase 2.
//
// Without Cloud Functions we can't strip fields server-side, so the
// "anonymity" properties are enforced by:
//   1. Splitting data into TWO collections from the client side (via
//      writeBatch — atomic), one private + one public.
//   2. Rules that deny non-admins from ever reading the private one.
//
// In effect: a helper has zero possible read paths to /ratings/{id}
// (which holds fromUid). They can only read the anonymized projection
// at /usersPublic/{helperUid}/ratings/{id}. Same outcome as the
// Cloud Function approach, just with the client doing the dual-write.
//
// The same trick applies to /users vs /usersPublic for cross-user
// display fields. Clients mirror their own profile into /usersPublic
// on every relevant write.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }
    function isAdmin() {
      return isSignedIn() && userDoc(request.auth.uid).role == 'admin';
    }
    function isVerifiedHelper() {
      return isSignedIn()
        && userDoc(request.auth.uid).role == 'helper'
        && userDoc(request.auth.uid).verified == true;
    }

    // -------- users (transitional: signed-in read until usersPublic backfill is everywhere) --------
    //
    // PHASE 2 ROLLOUT NOTE: long-term this should be:
    //   read = isSelf(uid) || isAdmin()
    // After every existing user has a /usersPublic mirror (the client now
    // creates one on every register / profile update / verify / availability
    // toggle), come back here and tighten this rule.
    match /users/{uid} {
      allow read:   if isSignedIn();
      allow create: if isSelf(uid)
        && request.resource.data.role in ['user', 'helper']
        && request.resource.data.uid == uid;
      allow update: if (isSelf(uid)
                        && !('role' in request.resource.data.diff(resource.data).affectedKeys())
                        && !('verified' in request.resource.data.diff(resource.data).affectedKeys()))
                    || isAdmin();
      allow delete: if isAdmin();
    }

    // -------- usersPublic (display projection, mirrored by client) --------
    // Read is open to any signed-in user. Self-write is allowed but
    // RESTRICTED to public-display fields only — never email or any
    // PII the user might leak by mistake. Admins can write anything.
    match /usersPublic/{uid} {
      allow read: if isSignedIn();

      // Self-mirror: can only contain whitelisted fields, with uid pinned.
      function isPublicProjection() {
        return request.resource.data.keys().hasOnly([
          'uid',
          'displayName',
          'role',
          'verified',
          'available',
          'helperStatus',
          'lastAvailableAt',
          'tags',
          'bio',
          'syncedAt'
        ])
        && request.resource.data.uid == uid;
      }

      allow create: if (isSelf(uid) && isPublicProjection())
                    || isAdmin();
      allow update: if (isSelf(uid) && isPublicProjection())
                    || isAdmin();
      allow delete: if isAdmin();

      // Per-helper anonymized rating mirror. Anyone signed in can write
      // a rating to any helper, but the doc must NOT contain fromUid.
      match /ratings/{ratingId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && request.resource.data.helperUid == uid
          && !('fromUid' in request.resource.data.keys())
          && request.resource.data.stars is int
          && request.resource.data.stars >= 1
          && request.resource.data.stars <= 5;
        allow update, delete: if isAdmin();
      }
    }

    // -------- chats --------
    match /chats/{chatId} {
      allow read: if isSignedIn()
        && (resource == null
            || request.auth.uid == resource.data.userUid
            || request.auth.uid == resource.data.helperUid);
      allow update: if isSignedIn()
        && (request.auth.uid == resource.data.userUid
            || request.auth.uid == resource.data.helperUid);
      allow create: if isSignedIn()
        && request.resource.data.userUid == request.auth.uid;
      allow delete: if isAdmin();

      // ---- chats/{chatId}/messages (Phase 2 J: Firestore-native messages) ----
      match /messages/{messageId} {
        function chatDoc() {
          return get(/databases/$(database)/documents/chats/$(chatId)).data;
        }
        function isParticipant() {
          return isSignedIn()
            && (request.auth.uid == chatDoc().userUid
                || request.auth.uid == chatDoc().helperUid);
        }
        allow read: if isParticipant();
        allow create: if isParticipant()
          && request.resource.data.from == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 4000;
        allow update, delete: if false; // immutable
      }
    }

    // -------- moods (private) --------
    match /moods/{moodId} {
      allow read, delete: if isSignedIn() && request.auth.uid == resource.data.uid;
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if isSignedIn()
        && request.auth.uid == resource.data.uid
        && !('uid' in request.resource.data.diff(resource.data).affectedKeys())
        && !('ts'  in request.resource.data.diff(resource.data).affectedKeys());
    }

    // -------- journal (private; payload may be E2E-encrypted by client) --------
    match /journal/{entryId} {
      allow read, delete, update: if isSignedIn() && request.auth.uid == resource.data.uid;
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
    }

    // -------- safety plans (private to owner) --------
    match /safetyPlans/{uid} {
      allow read, write: if isSelf(uid);
    }

    // -------- wall posts (community feed) --------
    match /wallPosts/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.body is string
        && request.resource.data.body.size() <= 1000;
      allow update: if isSignedIn()
                    && (
                      (request.auth.uid == resource.data.uid
                        && !('uid' in request.resource.data.diff(resource.data).affectedKeys()))
                      || request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['hearts','heartUids'])
                      || isAdmin()
                    );
      allow delete: if isSignedIn() && (request.auth.uid == resource.data.uid || isAdmin());

      match /replies/{replyId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.body is string
          && request.resource.data.body.size() <= 500;
        allow delete: if isSignedIn() && (request.auth.uid == resource.data.uid || isAdmin());
      }
    }

    // -------- helper-only supervision wall --------
    match /helperWall/{postId} {
      allow read: if isVerifiedHelper() || isAdmin();
      allow create: if isVerifiedHelper()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.body is string
        && request.resource.data.body.size() <= 1500;
      allow update: if (isSignedIn() && request.auth.uid == resource.data.uid
                        && (isVerifiedHelper() || isAdmin())
                        && !('uid' in request.resource.data.diff(resource.data).affectedKeys()))
                    || isAdmin();
      allow delete: if isAdmin()
                    || (isSignedIn() && request.auth.uid == resource.data.uid);
    }

    // -------- helper ratings (raw with fromUid) --------
    // Client dual-write writes here AND to /usersPublic/{helperUid}/ratings.
    // Only admins can read this collection — helpers see the
    // /usersPublic mirror, which has fromUid stripped at write-time.
    match /ratings/{ratingId} {
      allow read: if isAdmin();
      allow create: if isSignedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.stars is int
        && request.resource.data.stars >= 1
        && request.resource.data.stars <= 5;
      allow update, delete: if isAdmin();
    }

    // -------- companion memory (private to user, opt-in) --------
    match /companionMemory/{uid} {
      allow read, write: if isSelf(uid);
      match /items/{itemId} {
        allow read, write: if isSelf(uid);
      }
    }

    // -------- resources --------
    match /resources/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // -------- library (helper-authored articles & exercises) --------
    match /library/{id} {
      allow read: if isSignedIn() && (
        resource.data.status == 'approved'
        || request.auth.uid == resource.data.authorUid
        || isAdmin()
      );
      allow create: if isSignedIn()
        && userDoc(request.auth.uid).role == 'helper'
        && userDoc(request.auth.uid).verified == true
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.status == 'submitted'
        && request.resource.data.kind in ['article', 'exercise']
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 200
        && request.resource.data.body is string
        && request.resource.data.body.size() <= 10000;
      allow update: if isSignedIn() && (
        isAdmin()
        || (
          request.auth.uid == resource.data.authorUid
          && resource.data.status != 'approved'
          && !('status' in request.resource.data.diff(resource.data).affectedKeys())
          && !('authorUid' in request.resource.data.diff(resource.data).affectedKeys())
          && !('likes' in request.resource.data.diff(resource.data).affectedKeys())
          && !('likeUids' in request.resource.data.diff(resource.data).affectedKeys())
        )
        || (
          resource.data.status == 'approved'
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['likes', 'likeUids'])
        )
      );
      allow delete: if isSignedIn()
        && (request.auth.uid == resource.data.authorUid || isAdmin());
    }
  }
}
